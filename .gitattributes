# Normalize line endings to LF in the repository.
# Prevents CRLF/LF churn between Windows checkouts and CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets — never touch
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
*.aab binary
*.apk binary
