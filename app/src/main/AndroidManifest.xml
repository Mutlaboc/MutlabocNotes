<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Package-visibility declaration so ACTION_RECOGNIZE_SPEECH resolves to the
         device's speech recognizer on Android 11+ (voice dictation on note creation). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".HomeNotesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeNotes"
        android:usesCleartextTraffic="${USES_CLEARTEXT_TRAFFIC}"
        tools:targetApi="31">

        <meta-data
            android:name="com.yandex.auth.CLIENT_ID"
            android:value="${YANDEX_CLIENT_ID}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeNotes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yandexauth"
                    android:host="${YANDEX_CLIENT_ID}" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".DeadlineNotificationReceiver"
            android:exported="false" />
    </application>

</manifest>
